# Server Configuration
NODE_ENV=development
PORT=3000
API_VERSION=v1
CLIENT_URL=http://localhost:3001

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/wastefi

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# Metrics endpoint protection (/metrics requires this bearer token in production)
METRICS_TOKEN=change-me-in-production

# Stellar Configuration
# Encrypts the custodial Stellar secret keys stored for users. 64 hex characters,
# generate with: openssl rand -hex 32. Required in production. Keep it safe: losing
# it makes every stored wallet unrecoverable.
WALLET_ENCRYPTION_KEY=
STELLAR_NETWORK=testnet
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
STELLAR_MASTER_SECRET=SXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Recording approved collections on the Soroban contracts (see README). Off while
# SOROBAN_ADMIN_SECRET is empty. SOROBAN_CONTRACTS overrides the built-in testnet
# addresses with the "contracts" object of deployed_addresses_testnet.json.
SOROBAN_ADMIN_SECRET=
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
SOROBAN_CONTRACTS=

# Demo data for a public deployment (see README). Off unless SEED_DEMO_DATA=true and
# DEMO_ACCOUNT_PASSWORD meets the password policy.
SEED_DEMO_DATA=false
DEMO_ACCOUNT_PASSWORD=

# Mobile Money Configuration

# M-Pesa (Safaricom - Kenya)
MPESA_CONSUMER_KEY=your-mpesa-consumer-key
MPESA_CONSUMER_SECRET=your-mpesa-consumer-secret
MPESA_ENVIRONMENT=sandbox
MPESA_SHORTCODE=174379
MPESA_PASSKEY=your-mpesa-passkey
MPESA_CALLBACK_URL=https://yourdomain.com/api/v1/payments/callbacks/mpesa

# MTN Mobile Money
MTN_API_KEY=your-mtn-api-key
MTN_USER_ID=your-mtn-user-id
MTN_API_SECRET=your-mtn-api-secret
MTN_ENVIRONMENT=sandbox
MTN_SUBSCRIPTION_KEY=your-mtn-subscription-key
MTN_CALLBACK_URL=https://yourdomain.com/api/v1/payments/callbacks/mtn

# Airtel Money
AIRTEL_CLIENT_ID=your-airtel-client-id
AIRTEL_CLIENT_SECRET=your-airtel-client-secret
AIRTEL_ENVIRONMENT=sandbox
AIRTEL_CALLBACK_URL=https://yourdomain.com/api/v1/payments/callbacks/airtel

# SMS Configuration
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=your-twilio-phone-number

# Email Configuration
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-email-password
EMAIL_FROM=WasteFi <noreply@wastefi.com>

# Redis Configuration
REDIS_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# RecycleGraph Configuration
RECYCLEGRAPH_API_URL=https://api.recyclegraph.io
RECYCLEGRAPH_API_KEY=your-recyclegraph-api-key

# Logging
LOG_LEVEL=info
