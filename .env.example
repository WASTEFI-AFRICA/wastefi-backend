# Server Configuration
NODE_ENV=development
PORT=3000
API_VERSION=v1
CLIENT_URL=http://localhost:3001

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/wastefi

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# Stellar Configuration
STELLAR_NETWORK=testnet
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
STELLAR_MASTER_SECRET=SXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Mobile Money Configuration

# M-Pesa (Safaricom - Kenya)
MPESA_CONSUMER_KEY=your-mpesa-consumer-key
MPESA_CONSUMER_SECRET=your-mpesa-consumer-secret
MPESA_ENVIRONMENT=sandbox
MPESA_SHORTCODE=174379
MPESA_PASSKEY=your-mpesa-passkey
MPESA_CALLBACK_URL=https://yourdomain.com/api/v1/payments/callbacks/mpesa

# MTN Mobile Money
MTN_API_KEY=your-mtn-api-key
MTN_USER_ID=your-mtn-user-id
MTN_API_SECRET=your-mtn-api-secret
MTN_ENVIRONMENT=sandbox
MTN_SUBSCRIPTION_KEY=your-mtn-subscription-key
MTN_CALLBACK_URL=https://yourdomain.com/api/v1/payments/callbacks/mtn

# Airtel Money
AIRTEL_CLIENT_ID=your-airtel-client-id
AIRTEL_CLIENT_SECRET=your-airtel-client-secret
AIRTEL_ENVIRONMENT=sandbox
AIRTEL_CALLBACK_URL=https://yourdomain.com/api/v1/payments/callbacks/airtel

# SMS Configuration
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=your-twilio-phone-number

# Email Configuration
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-email-password
EMAIL_FROM=WasteFi <noreply@wastefi.com>

# Redis Configuration
REDIS_URL=redis://localhost:6379

# RecycleGraph Configuration
RECYCLEGRAPH_API_URL=https://api.recyclegraph.io
RECYCLEGRAPH_API_KEY=your-recyclegraph-api-key

# Logging
LOG_LEVEL=info
