# Test Environment Configuration
NODE_ENV=test
PORT=3001
API_VERSION=v1

# Test Database (use separate database for tests)
DATABASE_URL=postgresql://postgres:Holyspirit@localhost:5432/wastefi_test

# JWT Configuration
JWT_SECRET=test-secret-key
JWT_EXPIRES_IN=1h

# Stellar Configuration (testnet)
STELLAR_NETWORK=testnet
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
STELLAR_MASTER_SECRET=SXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Redis Configuration (disabled for tests by default)
REDIS_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379

# Disable external services for tests
SMS_PROVIDER=mock
EMAIL_HOST=mock
RECYCLEGRAPH_API_URL=http://localhost:9999

# Logging
LOG_LEVEL=error
