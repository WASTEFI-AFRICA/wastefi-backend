# Production Environment Configuration
# Copy this file to .env.production.local and fill in actual values

# Server Configuration
NODE_ENV=production
PORT=3000
API_VERSION=v1
CLIENT_URL=https://app.wastefi.com

# Database
DB_USER=postgres
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD
DB_NAME=wastefi
DB_PORT=5432
DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@postgres:5432/${DB_NAME}

# JWT Configuration
JWT_SECRET=CHANGE_ME_RANDOM_SECRET_KEY_MIN_32_CHARS
JWT_EXPIRES_IN=7d

# Stellar Configuration
STELLAR_NETWORK=testnet
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
STELLAR_MASTER_SECRET=SXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Redis Configuration
REDIS_ENABLED=true
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
REDIS_DB=0

# Mobile Money Configuration
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_ENVIRONMENT=production
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=https://api.wastefi.com/api/v1/payments/callbacks/mpesa

MTN_API_KEY=
MTN_USER_ID=
MTN_API_SECRET=
MTN_ENVIRONMENT=production
MTN_SUBSCRIPTION_KEY=
MTN_CALLBACK_URL=https://api.wastefi.com/api/v1/payments/callbacks/mtn

AIRTEL_CLIENT_ID=
AIRTEL_CLIENT_SECRET=
AIRTEL_ENVIRONMENT=production
AIRTEL_CALLBACK_URL=https://api.wastefi.com/api/v1/payments/callbacks/airtel

# SMS Configuration
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Email Configuration
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=WasteFi <noreply@wastefi.com>

# RecycleGraph Configuration
RECYCLEGRAPH_API_URL=https://api.recyclegraph.io
RECYCLEGRAPH_API_KEY=

# Logging
LOG_LEVEL=info

# Optional - Nginx
NGINX_PORT=80
NGINX_SSL_PORT=443
